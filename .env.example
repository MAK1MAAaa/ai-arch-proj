# Copy to .env and edit locally. Never commit real credentials.
# api_keys is a JSON list, tried in order only after HTTP401/403/429.
provider=openai
base_url='https://api.example.com/v1'
api_keys='[]'
model=''

# Legacy lowercase apikey is accepted only when api_keys is absent.
# Optional deployment aliases: ARCHSEARCH_LLM_PROVIDER, ARCHSEARCH_LLM_BASE_URL,
# ARCHSEARCH_LLM_API_KEYS and ARCHSEARCH_LLM_MODEL. Process aliases override .env.
# Empty keys and model keep the normal local Ollama selection workflow.
